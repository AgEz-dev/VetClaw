{
  "version": "1.0",
  "meta": {
    "purpose": "预问诊槽位模板 —— 决定「问什么」。话术由本模板给定，措辞由模型润色（问什么可控、怎么问自然）",
    "basis": "《预问诊-问诊项与话术规范-v0.1》：国内《诊断学》病史采集框架 + VIN(WSAVA 2003)《The Vomiting Dog》+ AKC 兽医问诊建议",
    "rules": {
      "max_questions_per_turn": 2,
      "max_turns": 12,
      "priority_order": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "stop_when": "所有 required 槽位 state != missing，或达 max_turns；后者须把未采集项写入 intake.incomplete（如实列出）",
      "emergency_override": "任一轮命中急症守卫 → 立即中断追问，置 intake.interrupted=true，提前给出 done"
    },
    "note": "synonyms 用于规则通道的选项匹配（宠主口语 ≠ 选项书面语）；未配 synonyms 的槽位走通用规则或 LLM 通道"
  },
  "base_slots": [
    {
      "key": "chief",
      "name": "主诉",
      "priority": "P1",
      "required": true,
      "ask": "它主要是什么不舒服？大概从什么时候开始的？",
      "free_text": true,
      "why": "主诉 = 主要症状 + 持续时间，是诊断方向的核心切入点"
    },
    {
      "key": "onset",
      "name": "起病时间与急缓",
      "priority": "P1",
      "required": true,
      "ask": "这个情况是突然出现的，还是慢慢变严重的？",
      "options": [
        "突然出现",
        "慢慢变严重"
      ],
      "synonyms": {
        "突然出现": [
          "突然",
          "一下子",
          "忽然"
        ],
        "慢慢变严重": [
          "慢慢",
          "逐渐",
          "越来越"
        ]
      },
      "why": "起病缓急决定急慢性判断"
    },
    {
      "key": "exposure",
      "name": "48h 摄入与接触史",
      "priority": "P0",
      "required": true,
      "ask": "发病前 48 小时内，它有没有可能吃到不该吃的东西？比如剩饭菜、垃圾、植物、骨头或玩具；有没有喂过新零食、或者换过粮？",
      "why": "兽医问诊首位：毒物 / 异物 / 换粮是最常见的三大诱因；明确 48h 时间窗"
    },
    {
      "key": "progression",
      "name": "发展与演变",
      "priority": "P2",
      "required": true,
      "ask": "这两天是越来越重，还是时好时坏？",
      "options": [
        "越来越重",
        "时好时坏",
        "好转",
        "无变化"
      ],
      "synonyms": {
        "越来越重": [
          "加重",
          "更严重",
          "越来越厉害",
          "越来越重了"
        ],
        "时好时坏": [
          "反复",
          "一阵一阵"
        ],
        "好转": [
          "好点了",
          "减轻",
          "见好"
        ],
        "无变化": [
          "差不多",
          "没变化"
        ]
      },
      "why": "现病史·发展演变；与治疗反应结合判断预后"
    },
    {
      "key": "treatment",
      "name": "诊疗经过及效果",
      "priority": "P1",
      "required": true,
      "ask": "您给它用过什么药，或者做过什么处理吗？有没有效果？",
      "free_text": true,
      "why": "现病史·诊疗经过须含药物、剂量、疗效；避免医生重复无效处理"
    },
    {
      "key": "general",
      "name": "一般情况",
      "priority": "P2",
      "required": true,
      "ask": "精神、食欲、饮水、大小便，还有体重，这几天有变化吗？",
      "free_text": true,
      "why": "现病史·一般情况（精神状态 / 食欲 / 体重改变 / 睡眠 / 大小便）"
    },
    {
      "key": "free_note",
      "name": "宠主补充",
      "priority": "P3",
      "required": false,
      "ask": "还有什么想告诉医生的吗？任何您觉得重要的都可以说，没有也可以直接跳过。",
      "why": "槽位是预设的，现实总会超出；开放式兜底 + 让宠主有掌控感",
      "constraint": "原话完整保留，不得归纳改写"
    },
    {
      "key": "other_findings",
      "name": "其他异常发现",
      "priority": "P3",
      "required": false,
      "ask": null,
      "why": "由 free_note 归类产生；归不进任何既有槽位的异常单独成条，并保留原话",
      "derived_from": "free_note"
    }
  ],
  "archive_slots": [
    {
      "key": "vaccine",
      "name": "预防接种",
      "priority": "P2",
      "required": true,
      "source": "archive",
      "data_source": "PetVaccination + VaccineCatalog",
      "ask_if_missing": "它最近的疫苗和驱虫是按时间做的吗？",
      "why": "既往史·预防接种；影响免疫安排 —— 档案有值不问，缺失必问",
      "ask": "它最近的疫苗和驱虫是按时间做的吗？"
    },
    {
      "key": "past_disease",
      "name": "既往疾病与手术",
      "priority": "P2",
      "required": true,
      "source": "archive",
      "data_source": "PetMedicalRecord",
      "ask_if_missing": "它以前得过什么病，或者做过手术吗？",
      "why": "既往史；与现病和处置安排相关 —— 档案有值不问，缺失必问",
      "ask": "它以前得过什么病，或者做过手术吗？"
    },
    {
      "key": "medications",
      "name": "在用药",
      "priority": "P1",
      "required": true,
      "source": "archive",
      "data_source": "PetPrescription",
      "ask_if_missing": "目前有在吃什么药吗？",
      "why": "既往史·在用药；直接影响开药安全 —— 档案有值不问，缺失必问",
      "ask": "目前有在吃什么药吗？"
    },
    {
      "key": "allergy",
      "name": "过敏史",
      "priority": "P1",
      "required": true,
      "source": "archive",
      "data_source": "PetInfo.allergies",
      "ask_if_missing": "有没有已知的过敏（药物、食物）？",
      "why": "既往史·过敏史；用药安全红线 —— 档案有值不问，缺失必问",
      "ask": "有没有已知的过敏（药物、食物）？"
    }
  ],
