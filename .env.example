# VetClaw 运行环境变量样例
# 复制为 .env 并填入真实值：cp .env.example .env

# 大模型 API（必填）
OPENAI_API_KEY=sk-your-key-here

# OpenAI 兼容接口地址（用硅基流动/其他代理时填，直连 OpenAI 留空）
OPENAI_BASE_URL=

# 模型名
VETCLAW_MODEL=gpt-4o-mini

# SDK 层单次请求 read timeout（秒）：防连接挂死
VETCLAW_TIMEOUT=15

# Agent 层总时长守卫（秒）：整个 ReAct 生命周期上限
VETCLAW_TOTAL_TIMEOUT=30

# 引擎开关：react（默认，零新增依赖）| langgraph（需 pip install -e ".[graph]"）
VETCLAW_ENGINE=react

# CORS 白名单，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
