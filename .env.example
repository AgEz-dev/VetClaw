# VetClaw 运行环境变量样例
# 复制为 .env 并填入真实值：cp .env.example .env

# 大模型 API（必填）
OPENAI_API_KEY=sk-your-key-here

# OpenAI 兼容接口地址（用硅基流动/其他代理时填，直连 OpenAI 留空）
OPENAI_BASE_URL=

# 模型名
VETCLAW_MODEL=gpt-4o-mini

# SDK 层单次请求 read timeout（秒）：防连接挂死
VETCLAW_TIMEOUT=15

# Agent 层总时长守卫（秒）：整个 ReAct 生命周期上限
VETCLAW_TOTAL_TIMEOUT=30

# ReAct 最大步数（工具循环与补正循环共用同一份预算）
VETCLAW_MAX_STEPS=5

# 引擎开关：react（默认，零新增依赖）| langgraph（需 pip install -e ".[graph]"）
VETCLAW_ENGINE=react

# CORS 白名单，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 医院业务系统内部接口（机机通信）：地址 + 共享密钥
# 密钥必须与医院侧 AI_INTERNAL_SECRET 完全一致；留空则远端工具一律返回
# HOSPITAL_NOT_CONFIGURED（不会匿名访问医院内部接口）。
VETCLAW_HOSPITAL_BASE_URL=http://127.0.0.1:8080
VETCLAW_HOSPITAL_SECRET=
